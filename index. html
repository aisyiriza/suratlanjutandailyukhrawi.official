<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#f8dfe7">
<title>Surat untuk Bunda | Daily Ukhrawi</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@600;700&family=Sacramento&display=swap');
*{box-sizing:border-box}
:root{--rose:#d9859d;--deep:#96566e;--cream:#fffaf6;--ink:#765563}
body{
 margin:0;min-height:100vh;padding:25px 14px 30px;display:flex;align-items:center;justify-content:center;
 background:radial-gradient(circle at 12% 12%,#fff 0 5%,transparent 24%),radial-gradient(circle at 90% 80%,#f4cbd8 0 4%,transparent 25%),linear-gradient(145deg,#fcebf0,#f7e5ef 48%,#eee6f6);
 color:var(--ink);font-family:'DM Sans',Arial,sans-serif;overflow-x:hidden
}
.wrap{width:min(100%,450px);text-align:center;position:relative}
.top-flower{font-size:23px;letter-spacing:8px;margin-bottom:7px;filter:drop-shadow(0 3px 4px #d18ba655)}
.brand{font-size:11px;letter-spacing:4px;font-weight:700;color:#a86d82}
.tagline{font-size:13px;color:#9b7887;margin:9px 0 20px}
.scene{height:340px;position:relative;perspective:1000px}
.letter{
 position:absolute;z-index:1;left:4%;width:92%;top:22px;height:282px;padding:24px 21px 20px;
 background:linear-gradient(160deg,#fffefa,#fff7f8);border:1px solid #f2d5df;border-radius:19px;
 box-shadow:0 14px 35px #a86b8326;text-align:left;overflow-y:auto;overscroll-behavior:contain;
 scrollbar-width:thin;scrollbar-color:#e4aabb #fff0f4;
 transform:translateY(72px) scale(.92);opacity:0;transition:transform .9s cubic-bezier(.2,.8,.2,1),opacity .65s ease
}
.letter:before{content:"";position:absolute;inset:8px;border:1px dashed #efc8d5;border-radius:13px;pointer-events:none}
.letter.open{transform:translateY(-12px) scale(1);opacity:1;z-index:4}
.letter-inner{position:relative}
.letter h1{font:700 25px 'Playfair Display',Georgia,serif;color:#a85e79;text-align:center;margin:0 0 5px}
.subtitle{text-align:center;color:#c18a9e;font-size:11px;letter-spacing:1.2px;margin-bottom:18px}
.letter p{font-size:13px;line-height:1.8;margin:0 0 12px;color:#765b67}
.letter .salute,.letter .signoff{color:#a35e78;font-weight:600}
.letter .question{background:#fff0f4;border-left:3px solid #df9caf;padding:10px 12px;border-radius:0 10px 10px 0}
.signature{text-align:center;font-family:'Sacramento',cursive;font-size:25px!important;color:#b56e88!important;margin-top:8px!important}
.envelope{position:absolute;z-index:3;left:3%;width:94%;bottom:0;height:190px;border:0;padding:0;background:transparent;cursor:pointer;filter:drop-shadow(0 13px 14px #a36a8030);transition:transform .45s ease}
.env-back{position:absolute;inset:0;background:linear-gradient(135deg,#e9a9bb,#d986a2);border-radius:13px}
.env-front{position:absolute;inset:0;background:linear-gradient(145deg,#f4c5d1,#e8a4b8);clip-path:polygon(0 0,50% 59%,100% 0,100% 100%,0 100%);border-radius:0 0 13px 13px}
.env-flap{position:absolute;top:0;left:0;width:100%;height:100%;background:linear-gradient(145deg,#f7d3dc,#e9a7ba);clip-path:polygon(0 0,100% 0,50% 58%);transform-origin:top;transition:transform .8s ease;z-index:2}
.seal{position:absolute;z-index:4;left:50%;top:91px;transform:translateX(-50%);width:47px;height:47px;border-radius:50%;background:linear-gradient(145deg,#bd6e8b,#a95475);color:#fff7fa;display:grid;place-items:center;font-size:22px;box-shadow:0 4px 10px #9e547255;border:2px solid #f9dce5}
.tap-label{position:absolute;z-index:5;left:0;right:0;bottom:15px;color:#fff;font-size:11px;font-weight:700;letter-spacing:.4px;text-shadow:0 1px 4px #914d68;pointer-events:none}
.scene.open .env-flap{transform:rotateX(180deg)}
.scene.open .envelope{transform:translateY(18px)}
.scene.open .seal{opacity:.25}
.controls{margin-top:15px;display:flex;justify-content:center;gap:10px;flex-wrap:wrap}
.controls button{border:0;border-radius:30px;padding:11px 18px;background:#fff9fb;color:#a35f79;box-shadow:0 5px 13px #b76f8920;font:600 12px 'DM Sans',Arial,sans-serif;cursor:pointer}
.controls button.primary{background:linear-gradient(135deg,#d9859d,#bd6e8b);color:white}
.note{font-size:10px;line-height:1.6;color:#a27d8d;margin:13px auto 0;max-width:330px}
.float{position:absolute;pointer-events:none;animation:float 4s ease-in-out infinite;opacity:.75}
.f1{top:70px;left:2%;font-size:24px}.f2{top:155px;right:1%;font-size:20px;animation-delay:1s}.f3{bottom:80px;left:1%;font-size:18px;animation-delay:2s}.f4{bottom:100px;right:3%;font-size:23px;animation-delay:.6s}
@keyframes float{0%,100%{transform:translateY(0) rotate(-7deg)}50%{transform:translateY(-12px) rotate(8deg)}}
@media(max-width:380px){.scene{height:325px}.letter{height:270px;padding:20px 17px}.letter p{font-size:12px}.letter h1{font-size:23px}}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
</style>
</head>
<body>
<div class="wrap">
 <span class="float f1">🌸</span><span class="float f2">♡</span><span class="float f3">✿</span><span class="float f4">✨</span>
 <div class="top-flower">🌷 ♡ 🌷</div>
 <div class="brand">DAILY UKHRAWI</div>
 <p class="tagline">Sepucuk surat, penuh doa dan harapan 🤍</p>

 <div class="scene" id="scene">
  <article class="letter" id="letter" aria-label="Isi pesan untuk Bunda">
   <div class="letter-inner">
    <h1>Pesan untuk Bunda</h1>
    <div class="subtitle">DENGAN HANGAT & KASIH SAYANG ✧</div>
    <p class="salute">Assalamu’alaikum warahmatullahi wabarakatuh, Bunda.</p>
    <p>Alhamdulillah, senang sekali melihat semangat Ananda dalam belajar Tahsin bersama Daily Ukhrawi. 🌷</p>
    <p>Setiap pertemuan adalah bagian dari proses Ananda untuk semakin mengenal dan memperbaiki bacaan Al-Qur’an.</p>
    <p>Kami berharap perjalanan baik ini bisa terus berlanjut, agar apa yang sudah dipelajari tidak berhenti sampai di sini dan Ananda semakin berkembang dalam setiap pertemuannya.</p>
    <p>Alhamdulillah, setelah kami tanyakan kepada Ananda, ternyata Ananda masih memiliki keinginan dan semangat untuk mengikuti pembelajaran Tahsin pada pertemuan selanjutnya. MasyaAllah, semoga semangat baik ini terus terjaga. 🤍</p>
    <p class="question">Bagaimana, Bunda? Apakah kita lanjutkan kembali perjalanan belajar Tahsin Ananda? 🌸</p>
    <p>Terima kasih sudah menjadi bagian dari keluarga belajar Daily Ukhrawi.</p>
    <p class="signoff">Wassalamu’alaikum warahmatullahi wabarakatuh.</p>
    <p class="signature">Salam hangat, Daily Ukhrawi ♡</p>
   </div>
  </article>
  <button class="envelope" id="envelope" type="button" aria-label="Tekan untuk membuka atau menutup amplop">
   <span class="env-back"></span><span class="env-front"></span><span class="env-flap"></span>
   <span class="seal">♡</span><span class="tap-label" id="tapLabel">TEKAN UNTUK MEMBUKA SURAT</span>
  </button>
 </div>
 <div class="controls">
  <button class="primary" type="button" id="openBtn">♡ Buka surat</button>
  <button type="button" id="closeBtn">Tutup amplop ✧</button>
 </div>
 <p class="note">Surat terbuka otomatis dan bergerak perlahan. Bunda juga bisa scroll sendiri. Tekan amplop untuk menutupnya kapan saja. Amplop akan menutup otomatis setelah 60 detik.</p>
</div>
<script>
(() => {
 const scene=document.getElementById('scene'),letter=document.getElementById('letter');
 const envelope=document.getElementById('envelope'),tapLabel=document.getElementById('tapLabel');
 let closeTimer=null,scrollFrame=null,userInteracting=false,interactionTimer=null;
 function stopAutoScroll(){if(scrollFrame)cancelAnimationFrame(scrollFrame);scrollFrame=null}
 function startAutoScroll(){
  stopAutoScroll();let direction=1,last=0;const speed=12;
  function step(now){
   if(!scene.classList.contains('open'))return;
   if(!userInteracting&&now-last>16){
    const delta=last?Math.min((now-last)/1000,.05):0;
    letter.scrollTop+=direction*speed*delta;
    if(letter.scrollTop+letter.clientHeight>=letter.scrollHeight-1)direction=-1;
    if(letter.scrollTop<=0)direction=1;
   }
   last=now;scrollFrame=requestAnimationFrame(step);
  }
  scrollFrame=requestAnimationFrame(step);
 }
 function closeEnvelope(){
  clearTimeout(closeTimer);stopAutoScroll();scene.classList.remove('open');letter.classList.remove('open');
  letter.scrollTop=0;tapLabel.textContent='TEKAN UNTUK MEMBUKA SURAT';
 }
 function scheduleClose(){clearTimeout(closeTimer);closeTimer=setTimeout(closeEnvelope,60000)}
 function openEnvelope(){
  clearTimeout(closeTimer);scene.classList.add('open');letter.classList.add('open');
  tapLabel.textContent='TEKAN UNTUK MENUTUP SURAT';startAutoScroll();scheduleClose();
 }
 envelope.addEventListener('click',()=>scene.classList.contains('open')?closeEnvelope():openEnvelope());
 document.getElementById('openBtn').addEventListener('click',openEnvelope);
 document.getElementById('closeBtn').addEventListener('click',closeEnvelope);
 function manualScroll(){
  userInteracting=true;clearTimeout(interactionTimer);
  interactionTimer=setTimeout(()=>userInteracting=false,3500);scheduleClose();
 }
 letter.addEventListener('wheel',manualScroll,{passive:true});
 letter.addEventListener('touchstart',manualScroll,{passive:true});
 letter.addEventListener('touchmove',manualScroll,{passive:true});
 letter.addEventListener('pointerdown',manualScroll);
 letter.addEventListener('keydown',manualScroll);
 window.addEventListener('load',()=>setTimeout(openEnvelope,900));
})();
</script>
</body>
</html>
